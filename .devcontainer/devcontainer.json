{
    // Name of the Dev Container configuration
    "name": "NMAP-Data-Correlation-Platform",
    // Specify the Docker Compose file to use for setting up the environment
    "dockerComposeFile": "docker-compose.yml",
    // The service VSCode should connect to (this corresponds to 'frontend' in docker-compose.yml)
    "service": "frontend",
    // Where VSCode will open the project folder inside the container
    "workspaceFolder": "/workspaces/NMAP-Data-Correlation-Platform",
    // The user VSCode will run as inside the container (root in this case)
    "remoteUser": "root"
}